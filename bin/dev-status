#!/bin/bash
# Says whether the Fathom running in this session is the working tree, and
# changes nothing: it compares the build identity the running plugin reports
# over IPC with bin/build-identity. Exits 0 when they match, 1 when another
# build runs, 2 when Fathom does not answer.

set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly project_root

wanted=$(bash "$project_root/bin/build-identity")
tree=$(git -C "$project_root" rev-parse --short HEAD)
[[ -z $(git -C "$project_root" status --porcelain) ]] || tree="$tree plus uncommitted changes"

if ! running=$(omarchy-shell fathom state 2>/dev/null | jq -er '.buildIdentity' 2>/dev/null); then
  printf 'Fathom does not answer: not installed, not enabled, or the shell is down.\n'
  printf 'Working tree: %s (%s). To install it: bash bin/dev-sync\n' "$wanted" "$tree"
  exit 2
fi

if [[ $running == "$wanted" ]]; then
  printf 'Up to date: the running Fathom is the working tree, %s (%s).\n' "$wanted" "$tree"
  exit 0
fi

printf 'Out of date: the running Fathom is %s, the working tree is %s (%s).\n' "$running" "$wanted" "$tree"
printf 'To install it: bash bin/dev-sync\n'
exit 1
